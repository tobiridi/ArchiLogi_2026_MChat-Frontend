@page "/teams"
@attribute [Authorize]

<PageTitle>MChat - équipes</PageTitle>

@if (NotifPopup is not null)
{
    <NotificationPopup
        Message="@NotifPopup.Message"
        NotifType="@NotifPopup.NotifType" />
}

<OverlayModal 
    IsVisible=@DisplayOverlayModal 
    ChildContent="null" 
    OnClose="() => { }" />

<section id="teams-header" class="d-flex flex-row justify-content-between align-items-center mb-4">
    <div class="d-flex flex-row align-items-center">
        <h2 class="mb-0 pb-2 @(GroupTeamSelected == 1 ? "selected" : null)" @onclick="() => UpdateGroupTeam(1)">
            Mes équipes
            <span class="badge">@Model.MyTeams.Count</span>
        </h2>

        <h2 class="ms-4 mb-0 pb-2 @(GroupTeamSelected == 2 ? "selected" : null)" @onclick="() => UpdateGroupTeam(2)">
            Équipes rejoint
            <span class="badge">@Model.JoinedTeams.Count</span>
        </h2>
    </div>
    <div class="btn-group-sm teams-btn-actions">
        <button class="btn" @onclick="CreateNewTeamOpenModal">
            <i class="fa-solid fa-plus"></i>
            Nouvelle équipe
        </button>
    </div>
</section>

<section id="teams-container">
    <div class="teams-grid">
        @{
            IEnumerable<TeamChat> displayTeams;
            switch (GroupTeamSelected)
            {
                case 1:
                    displayTeams = Model.MyTeams;
                    break;
                case 2:
                    displayTeams = Model.JoinedTeams;
                    break;
                default:
                    displayTeams = [];
                    break;
            }
        }

        @if(displayTeams.Any())
        {
            @foreach (var team in displayTeams)
            {
                <div class="card team-card" @onclick="() => OpenTeam(team.Id)")">
                    @{
                        string srcImg = team.CoverImageUrl is null ? "/assets/img/empty-picture.png" : team.CoverImageUrl;
                    }
                    <img class="card-img-top" src="@srcImg" alt="Image de couverture équipe @team.TeamName" />

                    <div class="card-body team-card-body">
                        <h5 class="card-title team-card-title">
                            @team.TeamName
                        </h5>

                        <div class="dropdown team-card-menu" @onclick:stopPropagation="true">
                            <button class="btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" @onclick="() => OpenTeamDropdownMenu(team)">
                                <i class="fa-solid fa-ellipsis-vertical"></i>
                            </button>

                            <ul class="dropdown-menu @(team.Equals(TeamChatDropDownMenu) ? "show" : null)">
                                <li>
                                    <button class="dropdown-item" @onclick="() => EditTeamOpenModal(team)">
                                        Modifier
                                    </button>
                                </li>

                                <li>
                                    <button class="dropdown-item" @onclick="() => DeleteTeamOpenModal(team)">
                                        Supprimer
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            }
        }
        else {
            <p>Aucune équipe de discussion à afficher.</p>
        }
    </div>
</section>

