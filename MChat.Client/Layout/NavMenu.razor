@if(NotifPopup is not null)
{
    <NotificationPopup
        Message="@NotifPopup.Message"
        NotifType="@NotifPopup.NotifType" />
}

<nav class="navbar navbar-expand-md">
    <div class="container-fluid">
        <NavLink class="navbar-brand" href="/" Match="NavLinkMatch.All">
            <img id="app-logo" src="favicon.png" alt="Icône du site" />
        </NavLink>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <NavLink class="nav-link fs-5" href="/teams" Match="NavLinkMatch.All">
                        <i class="fa-solid fa-users"></i> Équipes
                    </NavLink>
                </li>
            </ul>
            <button id="nav-btn-logout" class="btn" type="button" @onclick="Logout">
                Déconnexion
                <i class="fa-solid fa-right-from-bracket"></i>
            </button>
        </div>
    </div>
</nav>
