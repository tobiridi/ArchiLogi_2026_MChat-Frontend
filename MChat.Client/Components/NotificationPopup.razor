@if (IsVisible)
{
    <div class="toast-container position-fixed top-0 end-0 p-3">

        <div class="toast show notification-toast @BootstrapBackground"
             role="alert">

            <div class="toast-header ">

                <strong class="me-auto">
                    @Title
                </strong>

                <small>
                    @DateTime.UtcNow.ToShortTimeString()
                </small>

                <button type="button"
                        class="btn-close"
                        @onclick="Close">
                </button>

            </div>

            <div class="toast-body">
                @Message
            </div>

        </div>

    </div>
}